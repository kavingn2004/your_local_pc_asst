               "This is my job."]),
    "groot": dict(
        name="Groot", pitch="-35", rate="-25",
        leads=["I am Groot.", "I am Groot!", "I am Groot?"],
        quips=["I am Groot.", "I am Groot!", "I AM GROOT!",
               "We are Groot."]),
    "wanda": dict(
        name="Wanda", pitch="45", rate="-16",
        leads=["A vision.", "I sense something.", "Listen closely."],
