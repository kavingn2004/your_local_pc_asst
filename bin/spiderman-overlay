        leads=["HULK SAY!", "LISTEN!", "HULK REMIND!"],
        quips=["HULK SMASH!", "HULK STRONGEST ONE THERE IS!",
               "PUNY DESKTOP.", "HULK LIKE REMINDERS."]),
    "captain-america": dict(
        name="Captain America", pitch="-10", rate="-16",
        leads=["Heads up, soldier.", "On your left.", "Listen up."],
        quips=["I could do this all day.",
               "The price of freedom is high.",
