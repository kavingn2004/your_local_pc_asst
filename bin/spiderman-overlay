#!/usr/bin/env python3
"""Spider-Man live desktop overlay.
- small draggable character (move it anywhere with the mouse)
- left-click  -> a random action (quip / time / battery / next task / greet)
- right-click -> menu (add reminder, list, mute, quit)
- reminders / alarms / battery alerts -> speech bubble (typewriter) + voice
Runs over Wayland via XWayland."""
import os
os.environ.setdefault("GDK_BACKEND", "x11")

import json, time, random, subprocess
from pathlib import Path
from datetime import datetime, timedelta

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib

APP   = "Local_Asst"   # product name; the character is the persona
CONF  = Path.home() / ".config" / "spiderman"
TASKS = CONF / "tasks.json"
STATE = CONF / "state.json"
HERO  = CONF / "spiderman-hero.png"
ICON  = CONF / "spiderman.png"

SPRITE_H   = 120       # smaller character
VOICE_RATE = "-18"     # slower speech
TYPE_MS    = 38        # typewriter speed (ms per char)

def _read(p, d):
    try: return json.loads(p.read_text())
    except Exception: return d
def load_tasks():  return _read(TASKS, [])
def save_tasks(t): TASKS.write_text(json.dumps(t, indent=2))
def load_state():  return _read(STATE, {"muted": False})
def save_state(s):
    try: STATE.write_text(json.dumps(s, indent=2))
    except Exception: pass

def speak(text):
    if load_state().get("muted"): return
    try:
        c = char_cfg()
        subprocess.Popen(["spd-say", "-o", "espeak-ng", "-t", "male3",
                          "-p", c["pitch"], "-r", c["rate"], "-i", "100", text])
    except Exception:
        pass

def notify(title, body, urgency="normal"):
    """Notifications are branded with the chosen character, not a fixed name."""
    try:
        # branded as the product; the character's artwork shows who is speaking
        subprocess.Popen(["notify-send", "-a", APP, "-i", str(sprite_path()),
                          "-u", urgency, title or APP, body])
    except Exception:
        pass

# ---------- Google Tasks bridge (runs in the project venv) ----------
PROJ    = Path(__file__).resolve().parent.parent
VENV_PY = PROJ / ".venv" / "bin" / "python"
GSYNC   = PROJ / "lib" / "google_sync.py"
ISYNC   = PROJ / "lib" / "ical_sync.py"
GTOKEN  = Path.home() / ".config" / "spiderman" / "google" / "token.json"
CALCONF = Path.home() / ".config" / "spiderman" / "calendar.json"

def google_ready():
    return VENV_PY.exists() and GSYNC.exists() and GTOKEN.exists()

def calendar_ready():
    # EDS calendars come from GNOME Online Accounts; no config file required
    return (VENV_PY.exists() and ISYNC.exists()
            and (Path.home() / ".cache/evolution/calendar").exists())

def _spawn(mod, *args):
    try:
        subprocess.Popen([str(VENV_PY), str(mod), *args],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def google_call(*args):
    """Fire-and-forget call into google_sync.py; never blocks the UI."""
    if google_ready():
        _spawn(GSYNC, *args)

def calendar_call(*args):
    """Fire-and-forget call into ical_sync.py."""
    if calendar_ready():
        _spawn(ISYNC, *args)

CHARS_DIR = CONF / "characters"

# Each character gets its own voice settings and lines. pitch/rate are passed
# straight to spd-say, so the voice changes with the sprite.
CHARACTERS = {
    "spider-man": dict(
        name="Spider-Man", pitch="35", rate="-18",
        leads=["Thwip!", "Spider-sense tingling!", "Hey there, web-head!",
               "Your friendly neighborhood Spider-Man here!"],
        quips=["With great power comes great responsibility!",
               "Doing whatever a spider can!",
               "Web-shooters loaded and ready!",
               "Just hanging around... upside down, usually."]),
    "iron-man": dict(
        name="Iron Man", pitch="10", rate="-8",
        leads=["Heads up.", "Sir.", "Reminder from your favourite genius.",
               "Let's get to work."],
        quips=["I am Iron Man.",
               "Genius, billionaire, playboy, philanthropist.",
               "Sometimes you gotta run before you can walk.",
               "Arc reactor at full capacity."]),
    "thor": dict(
        name="Thor", pitch="-25", rate="-22",
        leads=["Hear me!", "By Odin's beard!", "Mortal!", "Attend!"],
        quips=["I am Thor, son of Odin!",
               "Bring me another desktop!",
               "This drink, I like it. Another!",
               "I have been fighting for many years."]),
    "hulk": dict(
